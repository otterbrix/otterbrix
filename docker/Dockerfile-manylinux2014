FROM quay.io/pypa/manylinux_2_28_x86_64 AS build_wheel

ENV PYTHONFAULTHANDLER=1

RUN yum install -y ninja-build python3-pip python3-devel wget unzip zip

# pip3 here is the system Python 3.6; conan 2.30 needs Python >= 3.7, so it comes from the image's pipx
RUN    pip3 install --upgrade pip && \
       pip3 install --no-cache-dir pytest==6.2.5 cmake==3.28.3 && \
       pipx install conan==2.30.0 && \
       conan profile detect --force && \
       conan remote add otterbrix https://conan.otterbrix.com --allowed-packages "actor-zeta/*"

WORKDIR /app

COPY ./conanfile.py ./conanfile.py
COPY ./profiles ./profiles
RUN conan install . -pr:h profiles/release -pr:b default --build=missing --build="m4/*" -of build/wheel -o build_python=True

COPY ./integration ./integration
COPY ./cmake ./cmake
COPY ./components ./components
COPY ./core ./core
COPY ./services ./services
COPY ./example ./example
COPY ./CMakeLists.txt ./CMakeLists.txt

COPY ./README.md ./README.md

RUN   PYBIN=(/opt/python/*/bin) && \
      for BIN in "${PYBIN[@]}";  do  \
      if [[  ${BIN} == *"cp310"* ]]; then \
          cp integration/python/otterbrix/pyproject.toml . && \
          ${BIN}/python3 -m pip install --no-cache-dir build && \
          CMAKE_ARGS="-DCMAKE_TOOLCHAIN_FILE=$PWD/build/wheel/generators/conan_toolchain.cmake" ${BIN}/python3 -m build --wheel --outdir dist . ; \
      fi \
      done

WORKDIR /app
RUN for whl in dist/otterbrix*.whl; do \
        auditwheel repair ${whl} -w ./work/dist/  &&\
        rm ${whl}; \
    done

FROM ubuntu:22.04

RUN apt update && \
    apt upgrade -y && \
    apt install -y \
        python3-pip \
        python3-venv && \
    pip3 install --no-cache-dir pytest==6.2.5

WORKDIR /app

COPY --from=build_wheel /app/work/dist/otterbrix-*.whl /app/
COPY ./integration  ./integration

RUN pip3 install ./otterbrix-*.whl
RUN python3 -c "import distutils.sysconfig as sysconfig; print(sysconfig.get_config_var('LIBDIR'))"
RUN python3 -c "from otterbrix import Client, Connection, Cursor, connect"
RUN pytest -v -s